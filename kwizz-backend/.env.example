# Copy this file to ".env" (same folder) and fill in your values.
# The backend loads it automatically on startup.

# Your Clerk JWKS URL (needed for saving custom quizzes and "my scores")
CLERK_JWKS_URL=https://evolved-skink-30.clerk.accounts.dev/.well-known/jwks.json

# Optional: enables the AI question generator. Without it, the app uses the
# basic fill-in-the-blank generator. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: which Claude model writes the questions (default: claude-haiku-5-5)
# ANTHROPIC_MODEL=claude-haiku-5-5
